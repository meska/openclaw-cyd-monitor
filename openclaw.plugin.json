{
  "id": "openclaw-cyd-monitor",
  "name": "OpenClaw CYD Monitor",
  "description": "Serves sanitized OpenClaw status metrics to an ESP32 CYD display",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "host": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "LAN address on which the display bridge listens"
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "default": 8765
      },
      "fastTtlMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 600000,
        "default": 30000,
        "description": "Minimum age before the in-process session scan refreshes on request"
      },
      "slowTtlMs": {
        "type": "integer",
        "minimum": 15000,
        "maximum": 3600000,
        "default": 60000,
        "description": "Minimum age before the serial CLI status/workboard cycle refreshes on request"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 60000
      },
      "activeMinutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1440,
        "default": 15
      },
      "workboard": {
        "type": "string",
        "default": "all",
        "description": "Board id to count, or all to aggregate every Workboard"
      },
      "executable": {
        "type": "string",
        "default": "openclaw"
      }
    }
  },
  "uiHints": {
    "host": {
      "label": "Listen address",
      "placeholder": "0.0.0.0"
    },
    "port": {
      "label": "Listen port"
    },
    "fastTtlMs": {
      "label": "Session scan TTL (ms)"
    },
    "slowTtlMs": {
      "label": "Slow cycle TTL (ms)"
    },
    "timeoutMs": {
      "label": "Command timeout (ms)"
    },
    "activeMinutes": {
      "label": "Active session window (minutes)"
    },
    "workboard": {
      "label": "Workboard id or all"
    },
    "executable": {
      "label": "OpenClaw executable"
    }
  }
}
